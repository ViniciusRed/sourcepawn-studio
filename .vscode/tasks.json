{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension in Watch Mode",
      "group": "build",
      "type": "shell",
      "command": "bun run watch",
      "options": {
        "cwd": "${workspaceFolder}/editors/code"
      },
      "problemMatcher": {
        "base": "$tsc-watch"
      },
      "isBackground": true
    },
    {
      "label": "Build Extension",
      "group": "build",
      "type": "shell",
      "command": "bun run build",
      "options": {
        "cwd": "${workspaceFolder}/editors/code"
      },
      "problemMatcher": {
        "base": "$tsc"
      }
    },
    {
      "label": "Build Server",
      "type": "shell",
      "command": "cargo build ${input:buildType}",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Package Extension",
      "type": "shell",
      "command": "mkdir -p languageServer && cp ${workspaceFolder}/target/${input:buildFolder}/sourcepawn-studio languageServer/ && bunx vsce package --target ${input:target}",
      "options": {
        "cwd": "${workspaceFolder}/editors/code"
      },
      "problemMatcher": []
    },
    {
      "label": "Build and Package Extension",
      "dependsOn": ["Build Server", "Package Extension"],
      "dependsOrder": "sequence",
      "problemMatcher": ["$rustc", "$tsc"]
    }
  ],
  "inputs": [
    {
      "id": "buildType",
      "type": "pickString",
      "description": "Select build type",
      "options": [
        {
          "label": "Release",
          "value": "--release"
        },
        {
          "label": "Debug",
          "value": ""
        }
      ]
    },
    {
      "id": "buildFolder",
      "type": "pickString",
      "description": "Select build folder",
      "options": ["release", "debug"]
    },
    {
      "id": "target",
      "type": "pickString",
      "description": "Select the target platform",
      "options": [
        "win32-x64",
        "win32-ia32",
        "linux-x64",
        "linux-arm64",
        "darwin-x64",
        "darwin-arm64"
      ]
    }
  ]
}
